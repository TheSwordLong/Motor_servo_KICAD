		(at 123.444 19.304 0)
		(effects
			(font
				(face "Times New Roman")
				(size 5.08 5.08)
			)
		)
		(uuid "16c0053e-9c77-415b-b4b6-ec683acc6815")
	)
	(text "模块电路功能：\n这是一个符合 USB-IF 规范的基础款 USB 2.0 Type-C 从设备接口电路，完整支持 USB PD 快充，\n核心实现Type-C 正反插兼容、USB 2.0 高速数据传输、5V 设备供电、ESD 静电防护四大核心功能。\n应用场景：\n该电路广泛应用于仅需基础供电 + USB 数据功能的设备，例如：嵌入式开发板 / 核心板、智能家居设备等。\n\n"
		(exclude_from_sim no)
		(at 263.144 180.34 0)
		(effects
			(font
				(face "宋体")
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "68fdd9f4-9a1d-431c-b053-704378e69148")
	)
	(text "340端"
		(exclude_from_sim no)
		(at 214.63 188.468 0)
		(effects
			(font
				(size 2.159 2.159)
				(thickness 0.4318)
				(bold yes)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "6d267144-5d95-4e4a-87e3-257302fcbabd")
	)
	(text "模块电路功能：\nCH340E是一款 USB 转串口芯片，支持完整的异步串行通信功能，波特率范围通常在 50bps 到 2Mbps 之间。\n通过适当的电平转换还可支持 RS232、RS485 和 RS422 接口标准。工作电压通常为 3.3V 或 5V。\n该原理图带有完整的接口防护以及电平转化电路。"
		(exclude_from_sim no)
		(at 59.436 209.55 0)
		(effects
			(font
				(face "宋体")
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "6dfa1406-b6f4-4369-b674-52d4ea8a0775")
	)
	(text "处理器端"
		(exclude_from_sim no)
		(at 146.05 188.468 0)
		(effects
			(font
				(size 2.159 2.159)
				(thickness 0.4318)
				(bold yes)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "8cd91431-abe2-4d3b-92b3-ad9b6cdb9228")
	)
	(text "UART 电平转换 电源域隔离"
		(exclude_from_sim no)
		(at 13.97 151.13 0)
		(effects
			(font
				(size 2.159 2.159)
				(thickness 0.4318)
				(bold yes)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "9335959c-ca7f-4cfa-88b9-661c3ae426a4")
	)
