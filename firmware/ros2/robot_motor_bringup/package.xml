<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_motor_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and the default robot.yaml for the GD32F303 robot motor driver.
    Bring-up defaults to read-only on a dedicated ROS domain, because the target
    host already runs a live control stack on domain 0.
  </description>
  <maintainer email="xinhua@example.com">xinhua</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_motor_driver</exec_depend>
  <exec_depend>robot_motor_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>robot_motor_driver</test_depend>
  <test_depend>ament_index_python</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
