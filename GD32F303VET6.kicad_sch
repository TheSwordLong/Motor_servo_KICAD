			)
			(justify left top)
		)
		(uuid "1ce9ba08-aaf8-4a41-b84d-de5445f9cdbb")
	)
	(text "接口命名说明：MCU_SPI_SLK 保留现有名称，实际连接 Flash 的 SCLK。\nMotor_start 控制 PWM 通道使能；它不直接表示电机正在转动。"
		(exclude_from_sim no)
		(at 22 300 0)
		(effects
			(font
				(face "宋体")
				(size 1.7 1.7)
			)
			(justify left top)
		)
		(uuid "3c72d056-83c7-47a1-b310-135d3ab2266c")
	)
	(text "MCU-06  扩展 GPIO 与总使能"
