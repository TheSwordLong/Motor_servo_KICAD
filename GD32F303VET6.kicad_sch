	)
	(text "MCU-09  Wi-Fi / OTA 接口\nPD8/55 = USART2_TX；PD9/56 = USART2_RX。\nUSART2 全重映射；关闭 CTS/RTS。\nESP GPIO10 开漏控制 NRST；BOOT0 不变。\n升级缓存使用现有 U8，详见 WiFi_OTA 子页。"
		(exclude_from_sim no)
		(at 357 193 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "827dbb93-91b9-4176-80bb-279f25d751a3")
	)
	(text "MCU-04  USB / 电机子页接口"
		(exclude_from_sim no)
		(at 254 26 0)
