	(text "WIFI-01  ESP32 与 GD32 通信【DNP】"
		(exclude_from_sim no)
		(at 15 15 0)
		(effects
			(font
				(face "Microsoft YaHei")
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "1c673f29-9d3c-4071-b389-66cb2c547f9b")
	)
	(text "C68=10uF、C70=100nF：3V3 去耦。\nR68=10k、C69=1uF：EN 延时。\nSW2：复位 ESP；沿用板上 +3V3。"
		(exclude_from_sim no)
		(at 177 130 0)
		(effects
			(font
				(face "Microsoft YaHei")
				(size 1.65 1.65)
			)
			(justify left top)
		)
		(uuid "3de77031-b804-44ae-8550-bf726e559b53")
	)
	(text "WIFI-04  原生 USB 下载接口【DNP】"
		(exclude_from_sim no)
		(at 15 159 0)
		(effects
			(font
				(face "Microsoft YaHei")
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "56a086dc-57a7-46e2-aac8-279f13332c72")
	)
	(text "U26：ESP32-C3-WROOM-02-N4。\nGPIO4 / 3 脚 TX → GD32 PA10 / 69 RX。\nGD32 PA9 / 68 TX → GPIO5 / 4 脚 RX。\nGD32 使用 USART0；UART 为 3.3V 直连。\nGPIO10 当前未接，不控制 GD32 NRST。\n9 / 19 脚接地；其余不用引脚保留 NC。"
		(exclude_from_sim no)
		(at 20 106 0)
		(effects
			(font
				(face "Microsoft YaHei")
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "919a1b37-febc-4992-b49a-df4399c6881f")
	)
	(text "R66 / R67：CC1 / CC2 各 5.1k 下拉。\nR69 / R70：USB 串联 22Ω，靠近模块。\nD+ → GPIO19 / 14；D- → GPIO18 / 13。\nVBUS 未接，使用时须由板卡供电。\n当前无外置 USB ESD；本页全部不装配。"
		(exclude_from_sim no)
		(at 170 236 0)
		(effects
			(font
				(face "Microsoft YaHei")
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "a109834c-e574-48f5-a55e-9e7434bcf4c3")
	)
	(text "WIFI-03  启动配置 / BOOT【DNP】"
		(exclude_from_sim no)
		(at 298 15 0)
		(effects
			(font
				(face "Microsoft YaHei")
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a428263a-e33b-46b7-9cc4-d132b88a11c4")
	)
	(text "备用页：原理图保留，元件排除 PCB / BOM。\nOTA/IAP 规划：网络 → ESP → UART → GD32 / U8 → Bootloader；升级固件尚未实现。"
		(exclude_from_sim no)
		(at 16 286 0)
		(effects
			(font
				(face "Microsoft YaHei")
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "e7097a72-681d-4ce2-86a3-fb194de47747")
	)
	(text "R71 / R72 / R73：各 10k 启动上拉。\n正常 GPIO9 高；下载时拉低。\n按住 BOOT → 按放 RESET → 松开 BOOT。"
		(exclude_from_sim no)
		(at 302 123 0)
		(effects
			(font
				(face "Microsoft YaHei")
				(size 1.65 1.65)
			)
			(justify left top)
		)
		(uuid "e8b8e36d-cb97-4237-b6b1-8a04a25ba6c1")
	)
	(text "WIFI-02  供电 / EN / RESET【DNP】"
		(exclude_from_sim no)
		(at 173 15 0)
		(effects
			(font
				(face "Microsoft YaHei")
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f7d7f28f-003c-435f-b77d-41a44c314d8b")
	)
